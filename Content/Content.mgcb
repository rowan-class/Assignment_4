
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#


#---------------------------------- Content ---------------------------------#

#begin LoadInfo/DialogueList.xml
/copy:LoadInfo/DialogueList.xml

#begin LoadInfo/ItemDefinitions.xml
/copy:LoadInfo/ItemDefinitions.xml

#begin LoadInfo/NPCDefinitions.xml
/copy:LoadInfo/NPCDefinitions.xml

#begin Maps/GrassMap.xml
/copy:Maps/GrassMap.xml

#begin Textures/Grass.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyColor=255,0,255,255
/processorParam:ColorKeyEnabled=False
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:MakeSquare=False
/processorParam:TextureFormat=Color
/processorParam:Version=3.8.5.1
/build:Textures/Grass.png


#begin Maps/HouseMap.xml
/copy:Maps/HouseMap.xml

#begin Textures/HouseWalls.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyEnabled=False
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:MakeSquare=False
/processorParam:TextureFormat=Color
/build:Textures/HouseWalls.png